node_modules/
.npm/
*.tsbuildinfo
coverage/

# PHP dependencies and test caches
vendor/
.phpunit.cache/
.phpunit.result.cache

# Go test output (keep source, go.mod, and go.sum)
*.test
coverage.out

# Local logs and operating-system files
*.log
.DS_Store
Thumbs.db

# Keep work evidence, delivered code, summaries, and dependency lock files tracked.
# work/ holds the project; description/ holds all reports. Neither folder is ignored.
# Cleanup follows workflow.md and preserves both sets of delivered outputs.
