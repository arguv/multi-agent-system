# Local secrets; retain shareable configuration examples
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python environments, caches, and coverage
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

